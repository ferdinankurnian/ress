<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ress_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/ress_native_light" android:clipToOutline="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
  <TextView android:id="@+id/ress_brand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:text="ress" android:textSize="30sp" android:fontFamily="@font/ress_vollkorn" />
  <TextView android:id="@+id/ress_status" android:layout_width="wrap_content" android:layout_height="match_parent" android:maxWidth="96dp" android:layout_marginEnd="8dp" android:gravity="center_vertical|end" android:includeFontPadding="false" android:textSize="10sp" android:fontFamily="@font/ress_hanken" android:maxLines="1" android:ellipsize="end" />
  <ImageView android:id="@+id/ress_refresh" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:scaleType="fitCenter" android:background="@drawable/ress_native_ripple" android:contentDescription="Refresh feeds" android:clickable="true" android:focusable="true" />
 </LinearLayout>
 <ListView android:id="@+id/ress_list_dark" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:scrollbarStyle="insideOverlay" android:padding="0dp" />
 <TextView android:id="@+id/ress_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/ress_hanken" android:textSize="16sp" android:visibility="gone" android:text="No articles here yet. Open Ress to add or refresh your sources." />
</LinearLayout>